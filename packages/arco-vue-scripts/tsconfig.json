{
  "compilerOptions": {
    "sourceMap": true,
    "outDir": "dist",
    "module": "CommonJS",
    "target": "ES2020",
    "allowJs": true,
    "moduleResolution": "node",
    "paths": {
      "vite": ["node_modules/vite/dist/node/index.d.ts"],
      "@vitejs/plugin-vue": [
        "node_modules/@vitejs/plugin-vue/dist/index.d.mts"
      ],
      "@vitejs/plugin-vue-jsx": [
        "node_modules/@vitejs/plugin-vue-jsx/dist/index.d.mts"
      ]
    },
    "baseUrl": ".",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2020"]
  },
  "include": ["src", "../web-vue/scripts/screentshot.ts"]
}
