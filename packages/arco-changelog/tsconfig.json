{
  "compilerOptions": {
    "sourceMap": true,
    "outDir": "dist",
    "module": "NodeNext",
    "target": "ES2018",
    "allowJs": true,
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2020"]
  },
  "include": ["src"]
}
