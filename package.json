{
  "name": "arco-design-vue-monorepo",
  "description": "Arco Design Vue 2.0 Monorepo",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "husky",
    "init": "pnpm -F @arco-design/arco-changelog -F @arco-design/vite-plugin-arco-vue-docs -F @arco-design/arco-vue-scripts run build && pnpm i && pnpm -F @ekworp/arco-design-vue run init",
    "start": "pnpm --filter @arco-design/arco-vue-docs run start",
    "build:site": "pnpm --filter @arco-design/arco-vue-docs run build",
    "test:screenshot": "pnpm --filter @arco-design/web-vue run test:screenshot",
    "build:component": "pnpm --filter @ekworp/arco-design-vue run build",
    "docgen": "pnpm --filter @ekworp/arco-design-vue run docgen",
    "clean": "pnpm -r exec rimraf dist node_modules",
    "test": "pnpm --filter @ekworp/arco-design-vue run test",
    "storybook": "pnpm --filter @arco-design/web-vue-storybook run storybook",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "outdated": "pnpm outdated -r"
  },
  "packageManager": "pnpm@11.27.0",
  "workspaces": [
    "packages/*"
  ],
  "author": "ArcoDesign Team",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "^7.0.2"
  }
}
